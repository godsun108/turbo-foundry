{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earth-studio.local/schemas/earthsession-v1.schema.json",
  "title": "EARTH STUDIO Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "id",
    "name",
    "createdAt",
    "updatedAt",
    "tempo",
    "meter",
    "sampleRate",
    "tracks",
    "assets"
  ],
  "properties": {
    "format": {
      "const": "earthsession"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tempo": {
      "type": "number",
      "minimum": 40,
      "maximum": 240
    },
    "meter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "denominator": {
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32
          ]
        }
      }
    },
    "sampleRate": {
      "type": "integer",
      "enum": [
        44100,
        48000,
        88200,
        96000,
        176400,
        192000
      ]
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "gain",
          "pan",
          "muted",
          "solo",
          "clips"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "enum": [
              "audio",
              "midi",
              "instrument"
            ]
          },
          "gain": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "pan": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "muted": {
            "type": "boolean"
          },
          "solo": {
            "type": "boolean"
          },
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "assetId",
                "startSeconds",
                "sourceStartSeconds",
                "durationSeconds"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "assetId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "startSeconds": {
                  "type": "number",
                  "minimum": 0
                },
                "sourceStartSeconds": {
                  "type": "number",
                  "minimum": 0
                },
                "durationSeconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "storageKey",
          "mediaType",
          "sizeBytes",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "storageKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
