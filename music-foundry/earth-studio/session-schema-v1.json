{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earth-studio.local/schemas/earthsession-v1.schema.json",
  "title": "EARTH STUDIO Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "id",
    "name",
    "createdAt",
    "updatedAt",
    "tempo",
    "meter",
    "sampleRate",
    "tracks",
    "assets"
  ],
  "properties": {
    "format": {
      "const": "earthsession"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tempo": {
      "type": "number",
      "minimum": 40,
      "maximum": 240
    },
    "meter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "denominator": {
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32
          ]
        }
      }
    },
    "sampleRate": {
      "type": "integer",
      "enum": [
        44100,
        48000,
        88200,
        96000,
        176400,
        192000
      ]
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "gain",
          "pan",
          "muted",
          "solo",
          "clips"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "enum": [
              "audio",
              "midi",
              "instrument"
            ]
          },
          "gain": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "pan": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "muted": {
            "type": "boolean"
          },
          "solo": {
            "type": "boolean"
          },
          "sceneIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "assetId",
                "startSeconds",
                "sourceStartSeconds",
                "durationSeconds"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "assetId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "startSeconds": {
                  "type": "number",
                  "minimum": 0
                },
                "sourceStartSeconds": {
                  "type": "number",
                  "minimum": 0
                },
                "durationSeconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "loop": {
                  "type": "boolean"
                }
              }
            }
          },
          "midiClips": {
            "type": "array",
            "description": "Optional inline MIDI clips. Omitted on legacy sessions; note positions are relative to each clip in 960-PPQ ticks.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "startTick",
                "lengthTicks",
                "notes"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "startTick": {
                  "type": "integer",
                  "minimum": 0
                },
                "lengthTicks": {
                  "type": "integer",
                  "minimum": 1
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "note",
                      "startTick",
                      "durationTicks",
                      "velocity",
                      "channel"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "note": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 127
                      },
                      "startTick": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "durationTicks": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "velocity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 127
                      },
                      "channel": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 15
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "storageKey",
          "mediaType",
          "sizeBytes",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "storageKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "midiCCMappings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attack": {
              "type": "object",
              "additionalProperties": false,
              "required": ["controller"],
              "properties": {"controller": {"type": "integer", "minimum": 0, "maximum": 127}}
            },
            "decay": {
              "type": "object",
              "additionalProperties": false,
              "required": ["controller"],
              "properties": {"controller": {"type": "integer", "minimum": 0, "maximum": 127}}
            },
            "sustain": {
              "type": "object",
              "additionalProperties": false,
              "required": ["controller"],
              "properties": {"controller": {"type": "integer", "minimum": 0, "maximum": 127}}
            },
            "release": {
              "type": "object",
              "additionalProperties": false,
              "required": ["controller"],
              "properties": {"controller": {"type": "integer", "minimum": 0, "maximum": 127}}
            },
            "cutoff": {
              "type": "object",
              "additionalProperties": false,
              "required": ["controller"],
              "properties": {"controller": {"type": "integer", "minimum": 0, "maximum": 127}}
            },
            "vibrato": {
              "type": "object",
              "additionalProperties": false,
              "required": ["controller"],
              "properties": {"controller": {"type": "integer", "minimum": 0, "maximum": 127}}
            },
            "bend": {
              "type": "object",
              "additionalProperties": false,
              "required": ["controller"],
              "properties": {"controller": {"type": "integer", "minimum": 0, "maximum": 127}}
            }
          }
        }
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oscillator",
        "attack",
        "decay",
        "sustain",
        "release",
        "cutoff",
        "vibrato",
        "bend"
      ],
      "properties": {
        "oscillator": {
          "enum": [
            "sine",
            "sawtooth",
            "square",
            "triangle"
          ]
        },
        "attack": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "decay": {
          "type": "number",
          "minimum": 1,
          "maximum": 2000
        },
        "sustain": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "release": {
          "type": "number",
          "minimum": 10,
          "maximum": 4000
        },
        "cutoff": {
          "type": "number",
          "minimum": 80,
          "maximum": 18000
        },
        "vibrato": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "bend": {
          "type": "number",
          "minimum": -12,
          "maximum": 12
        }
      }
    }
  }
}
